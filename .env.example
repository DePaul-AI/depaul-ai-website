# Copy to .env.local for local development. In production, set these in your
# hosting provider's environment variables (Netlify → Site configuration → Environment variables).

# Public URL of the site (used in Slack messages and metadata)
SITE_URL=https://depaulai.org

# --- Slack app (see slack/manifest.yml and README) ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
# Optional: comma-separated channel IDs where /dai works (e.g. your #website channel)
SLACK_ALLOWED_CHANNELS=
# Optional: comma-separated Slack user IDs allowed to edit. Empty = anyone in the allowed channels.
SLACK_ALLOWED_USERS=

# --- Where content is saved ---
# Fine-grained GitHub token with "Contents: Read and write" on this repo only
GITHUB_TOKEN=
GITHUB_REPO=DePaul-AI/depaul-ai-website
GITHUB_BRANCH=main
# Set to "local" to edit the files in /content directly (for trying the bot locally)
# CONTENT_STORE=local
